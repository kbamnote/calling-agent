# ─────────────────────────────────────────────────────────────────────────────
# Tapify Voice Agent
#
# Everything below has a working default. Copy to .env and you can run
# `npm run chat` with no keys, no CRM and no telephony account.
# ─────────────────────────────────────────────────────────────────────────────

PORT=5010
LOG_LEVEL=info          # error | warn | info | debug  (debug prints every tool call)

# ── LLM ──────────────────────────────────────────────────────────────────────
# mock    — scripted deterministic agent. No key. Exercises the whole pipeline,
#           tool calls included, so you can test plumbing before buying anything.
# gemini  — real conversation. Free tier is enough for testing.
#           Key: https://aistudio.google.com/apikey
# openai  — any OpenAI-compatible endpoint: OpenAI, Groq, Together, OpenRouter,
#           or a local Ollama / llama.cpp server.
LLM_PROVIDER=mock
LLM_MODEL=
LLM_MAX_TOKENS=220      # deliberately small: a voice agent must not monologue

GEMINI_API_KEY=
# Defaults to gemini-3.8-flash — cheap, fast, good enough Hinglish.
# Google retires model aliases; a retired one 404s on every turn and the agent
# cannot speak. /diagnostics names the replacement, then set LLM_MODEL here.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# For Ollama: OPENAI_BASE_URL=http://localhost:11434/v1 and OPENAI_API_KEY=ollama

# ── Speech to text ───────────────────────────────────────────────────────────
# browser  — the browser tester does STT locally with the Web Speech API.
#            Free, no key, decent Hindi on Chrome/Edge. Cannot be used for real
#            phone calls (there is no browser on a phone line).
# deepgram — streaming, production quality.
# sarvam   — Indian, Hindi-first, cheapest per minute for Hinglish.
STT_PROVIDER=browser
STT_LANGUAGE=hi-IN
# Sarvam retires model versions; a dead one is a 400 on every utterance and the
# agent hears nothing while the call looks fine. Override if saaras:v3 goes too.
SARVAM_STT_MODEL=
DEEPGRAM_API_KEY=
SARVAM_API_KEY=

# ── Text to speech ───────────────────────────────────────────────────────────
# browser     — the tester speaks via the Web Speech API. Free, no key.
# elevenlabs  — best quality, most expensive.
# sarvam      — Indian voices, cheapest for Hindi.
# none        — text only (what `npm run chat` uses).
TTS_PROVIDER=browser
# How fast the agent talks. 1.0 is Sarvam's default and is slow for a phone
# call; 1.15 reads as brisk. Above ~1.3 it starts to sound clipped.
SARVAM_PACE=

# Sarvam bulbul:v3 speakers — names are tied to the model version, and a v2 name
# on v3 is a 400 on every synthesis (the agent goes mute).
#   female  ritu, priya (default), neha, pooja, simran, kavya, ishita, shreya, roopa, ana
#   male    aditya, ashutosh, rahul, rohan, amit, dev, ratan, varun, manan,
#           sumit, kabir, aayan, shubh, advait
# Pin the model itself with SARVAM_TTS_MODEL if Sarvam deprecates v3.
TTS_VOICE=
ELEVENLABS_API_KEY=

# ── CRM (salescrm-pro) ───────────────────────────────────────────────────────
# false = the agent runs against in-memory stubs, so you can test conversation
# without a database. Flip to true once /api/agent/* is deployed.
CRM_ENABLED=false
CRM_BASE_URL=http://localhost:5000
# Must match AGENT_SERVICE_KEY on the CRM. Never ship this to a browser.
AGENT_SERVICE_KEY=

# ── Conversation guardrails (PRD §20, and the main cost lever) ───────────────
# A cap is not a nicety: without it a confused call runs for ten minutes and
# bills you for all of it.
# A short cached line ("Ek second sir.") spoken when a turn has stayed silent
# this long, so the caller does not think the call dropped. 0 disables it.
THINKING_FILLER_MS=

MAX_TURNS=14
MAX_CALL_SECONDS=300
# Hang up if the customer says nothing at all for this long.
SILENCE_HANGUP_SECONDS=12
# Do not open the STT/LLM session until human speech is heard. On a typical 30%
# connect rate this removes AI cost from ~70% of dials entirely.
GREETING_GATE=true

# ── Telephony ────────────────────────────────────────────────────────────────
# Undecided by design — the transport is a generic bidirectional media
# websocket, which is the shape Exotel, Plivo and a raw SIP bridge all expose.
# Set the provider once you have an account; see README "Wiring telephony".
# plivo   — verified against Plivo's Audio Streaming protocol reference.
#           Answer URL:  https://<host>/telephony/answer
#           Hangup URL:  https://<host>/telephony/status
#           Uses L16 @ 16 kHz, so no transcoding anywhere in the pipeline.
# exotel  — Twilio-shaped, UNVERIFIED. Check its docs before the first call.
# generic — a raw SIP media bridge.
TELEPHONY_PROVIDER=none     # none | plivo | exotel | generic
TELEPHONY_WEBHOOK_SECRET=

# ── OUTBOUND CALLING ─────────────────────────────────────────────────────────
# Needed only to PLACE calls; inbound works without them. From the Plivo console
# dashboard. Without all three, /calls/outbound and /calls/campaign refuse.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=

# Calling hours, IST. A service call outside these annoys the customer you rang
# to keep happy. Widen deliberately, not casually.
CALL_START_HOUR=10
CALL_END_HOUR=19
# Seconds Plivo rings an unanswered number before giving up.
RING_TIMEOUT_SECONDS=30
# Gap between calls in a campaign. Sequential on purpose — the bottleneck is
# people answering, not our throughput.
DIAL_GAP_MS=20000
# Hard ceiling on one campaign request, whatever `limit` asks for.
CAMPAIGN_MAX=50

# Voice activity detection, tuned from real Plivo call levels (line noise peaked
# ~0.046, speech ~0.27). Raise VAD_THRESHOLD if the connect gate opens on silence
# — the log prints the peak level every 2s, so tune from that, not from guesswork.
VAD_THRESHOLD=
VAD_SPEECH_MS=
# Trailing silence that ends a customer's turn. Dead air the caller sits through
# before anything happens, so shorter is better — but too short splits a
# mid-sentence pause into two fragments.
VAD_SILENCE_MS=

# The ABSOLUTE level required to interrupt the agent mid-sentence, and how long
# it must be sustained. NOT adaptive on purpose: a false interrupt cancels the
# agent's reply and the caller hears nothing at all. On a real line, noise
# measured 0.006-0.052 and speech 0.18-0.27.
BARGE_IN_LEVEL=
BARGE_IN_MS=
# How long after the agent's audio ends we keep ignoring the inbound track,
# so its own voice echoing back is not mistaken for the caller.
ECHO_TAIL_MS=

# Outbound audio pacing. Too much lead overflows the provider's buffer and it
# truncates the sentence; too little starves playback into a stutter.
AUDIO_CHUNK_MS=
AUDIO_LEAD_MS=

# Only needed if the proxy does not set x-forwarded-proto / x-forwarded-host.
# Railway does, so leave this empty there.
PUBLIC_URL=

# ── Cost ledger ──────────────────────────────────────────────────────────────
# Planning-only rates used to estimate cost per call. Replace with your real
# contracted rates — these are NOT quotes from any vendor.
RATE_TELEPHONY_INR_PER_MIN=0.45
RATE_STT_INR_PER_MIN=0.60
RATE_TTS_INR_PER_1K_CHARS=1.20
RATE_LLM_INR_PER_1K_IN=0.02
RATE_LLM_INR_PER_1K_OUT=0.08

# ── Deployment ───────────────────────────────────────────────────────────────
# Gates the browser tester. Starting a call from it spends LLM and TTS budget, so
# a deployed instance must not leave that open to whoever finds the URL.
# REQUIRED in production — without it the tester is disabled (the phone line is
# unaffected). Open the page as  https://<host>/?t=<TESTER_TOKEN>
TESTER_TOKEN=

# Set by the platform. Railway injects PORT itself; do not hard-code it there.
# NODE_ENV=production also turns on the tester gate above.

# ── Call recording ───────────────────────────────────────────────────────────
# OFF by default, and it must stay off until the GREETING tells the customer the
# call is recorded. Recording someone who was not told is not a default.
# Stereo MP3, customer left / agent right, ~277 KB for a 68-second call.
RECORDING_ENABLED=false
RECORDING_BITRATE_KBPS=32
RECORDING_MAX_SECONDS=300
# Its OWN Cloudinary account, not the one serving product images: recordings are
# personal data with a retention clock, and deleting them must never risk
# anything a customer's site depends on.
RECORDING_CLOUDINARY_CLOUD_NAME=
RECORDING_CLOUDINARY_API_KEY=
RECORDING_CLOUDINARY_API_SECRET=
# Only if you cannot use a signed upload. Anyone who learns a preset name can
# upload to the account with it.
RECORDING_CLOUDINARY_UPLOAD_PRESET=
RECORDING_CLOUDINARY_FOLDER=tapify-ai-calls
